# Application
APP_NAME="RiDDiX Invite Portal"
APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Used directly for local development; docker-compose builds the URL from POSTGRES_* vars
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5432/invite_portal"

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=portal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=invite_portal

# Session + encryption key — generate with: openssl rand -hex 32
# Also used for AES-256-GCM encryption of server admin tokens and integration secrets.
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_DEPLOY

# Synapse (legacy single-server — optional if using multi-server management)
# These are only used as fallback when no ManagedServer is configured.
# SYNAPSE_INTERNAL_URL=http://synapse:8008
# SYNAPSE_PUBLIC_URL=https://matrix.example.com
# SYNAPSE_SERVER_NAME=example.com
# SYNAPSE_ADMIN_ACCESS_TOKEN=CHANGE_ME_SYNAPSE_ADMIN_TOKEN

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=15

# Optional CAPTCHA (hCaptcha or reCAPTCHA)
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
